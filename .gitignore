# 保留内层原仓库，不把其 Git 元数据上传为子模块。
ukey/.git/

# 本机运行数据、构建结果和临时检查资料。
**/.runtime/
**/target/
**/dist/
**/__pycache__/
**/tmp/
**/logs/
*.log
*.log.gz
*.class
*.pyc
.DS_Store

# 私钥、证书存储、口令及平台发布的运行配置。
*.p12
*.pfx
*.jks
*.key
*.pem
**/secrets.properties
**/.env
**/.env.*
web-plugin/config/
web-plugin/backups/

# 原厂二进制、原始手册和未核查的历史证据仅在本机保留。
*.jar
web-plugin/docs/*.pdf
ukey/artifacts/
ukey/evidence/
ukey/validation/
